generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  nik                     String    @id @db.VarChar(50)
  nama_lengkap            String    @db.VarChar(255)
  jenis_kelamin           String?   @db.VarChar(20)
  tempat_lahir            String?   @db.VarChar(100)
  tanggal_lahir_raw       String?   @db.VarChar(100)
  pendidikan_terakhir     String?   @db.VarChar(100)
  alamat_lengkap          String?
  nomor_hp                String?   @db.VarChar(30)
  jumlah_anggota_keluarga Int?
  status_keanggotaan      String?   @db.VarChar(100)
  lands                   Land[]
  work_logs               WorkLog[]

  @@map("users")
}

model Land {
  id                    String           @id @default(uuid()) @db.Uuid
  owner_nik             String           @db.VarChar(50)
  nama_kelompok_tani    String?          @db.VarChar(255)
  lokasi_kebun          String?
  luas_ha               Decimal?         @db.Decimal(10, 4)
  status_kepemilikan    String?          @db.VarChar(100)
  jenis_sertifikasi     String?          @db.VarChar(100)
  usia_tanam_raw        String?          @db.VarChar(100)
  baseline_produksi_ton Decimal?         @db.Decimal(10, 4)
  produksi_raw          String?          @db.VarChar(100)
  pabrik_mitra          String?          @db.VarChar(255)
  jenis_bibit           String?          @db.VarChar(100)
  koordinat_gps         String?
  costs                 Cost[]
  harvests              Harvest[]
  owner                 User             @relation(fields: [owner_nik], references: [nik], onDelete: Cascade)
  weighbridge_logs      WeighbridgeLog[]
  work_logs             WorkLog[]

  @@map("lands")
}

model WorkLog {
  id             String   @id @default(uuid()) @db.Uuid
  worker_nik     String   @db.VarChar(50)
  land_id        String   @db.Uuid
  check_in_time  DateTime
  check_out_time DateTime
  tonase         Decimal  @db.Decimal(10, 4)
  created_at     DateTime @default(now())
  jumlah_janjang Int?
  land           Land     @relation(fields: [land_id], references: [id], onDelete: Cascade)
  worker         User     @relation(fields: [worker_nik], references: [nik], onDelete: Cascade)

  @@map("work_logs")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Harvest {
  id                String   @id @default(uuid()) @db.Uuid
  land_id           String   @db.Uuid
  tanggal_panen     DateTime @db.Date
  jumlah_janjang    Int
  estimasi_berat_kg Decimal  @db.Decimal(10, 2)
  created_at        DateTime @default(now())
  land              Land     @relation(fields: [land_id], references: [id], onDelete: Cascade)

  @@map("harvests")
}

model Cost {
  id           String   @id @default(uuid()) @db.Uuid
  land_id      String   @db.Uuid
  tanggal      DateTime @db.Date
  jenis_biaya  String   @db.VarChar(100)
  jumlah_biaya Decimal  @db.Decimal(15, 2)
  keterangan   String?
  created_at   DateTime @default(now())
  land         Land     @relation(fields: [land_id], references: [id], onDelete: Cascade)

  @@map("costs")
}

model WeighbridgeLog {
  id              String    @id @default(uuid()) @db.Uuid
  nomor_kendaraan String    @db.VarChar(20)
  nama_supir      String?   @db.VarChar(255)
  sumber          String    @db.VarChar(20)
  land_id         String?   @db.Uuid
  nama_pemasok    String?   @db.VarChar(255)
  berat_bruto_kg  Decimal   @db.Decimal(10, 2)
  berat_tara_kg   Decimal?  @db.Decimal(10, 2)
  berat_netto_kg  Decimal?  @db.Decimal(10, 2)
  waktu_masuk     DateTime  @default(now())
  waktu_keluar    DateTime?
  status          String    @default("masuk") @db.VarChar(20)
  created_at      DateTime  @default(now())
  land            Land?     @relation(fields: [land_id], references: [id])

  @@map("weighbridge_logs")
}

model MillProduction {
  id                String     @id @default(uuid()) @db.Uuid
  tanggal_produksi  DateTime   @db.Date
  tbs_olah_kg       Decimal    @db.Decimal(12, 2)
  cpo_dihasilkan_kg Decimal    @db.Decimal(12, 2)
  pk_dihasilkan_kg  Decimal    @db.Decimal(12, 2)
  oer_persen        Decimal?   @db.Decimal(5, 2)
  ker_persen        Decimal?   @db.Decimal(5, 2)
  catatan           String?
  created_at        DateTime   @default(now())
  losses            MillLoss[]

  @@map("mill_productions")
}

model MillLoss {
  id                  String          @id @default(uuid()) @db.Uuid
  production_id       String?         @db.Uuid
  tanggal             DateTime        @db.Date
  tahap_proses        String          @db.VarChar(50)
  jenis_losses        String          @db.VarChar(100)
  losses_kg           Decimal         @db.Decimal(10, 2)
  kadar_minyak_persen Decimal?        @db.Decimal(5, 2)
  oil_losses_kg       Decimal?        @db.Decimal(10, 2)
  catatan             String?         @db.Text
  created_at          DateTime        @default(now())
  production          MillProduction? @relation(fields: [production_id], references: [id])

  @@map("mill_losses")
}
